-- Fresh final schema only. Never DROP an existing table or its financial history.
CREATE TABLE runs (
    run_id Utf8, entry_id Utf8, day Utf8, mode Utf8, status Utf8,
    operation Utf8, cost_rub Utf8, created_at Timestamp, payload String,
    PRIMARY KEY (run_id, entry_id)
);
-- runs intentionally has NO TTL.
